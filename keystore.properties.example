# Copy to `android/keystore.properties` and fill in real values.
# Used by android/app/build.gradle for release signing. NEVER commit the real file.
#
# Generate the keystore first:
#   cd android
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore release.keystore -alias myapp-release \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=your-store-password
keyAlias=myapp-release
keyPassword=your-key-password
