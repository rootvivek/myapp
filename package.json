{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "run:android": "expo run:android",
    "sync:jdk": "node scripts/sync-android-jdk.js",
    "build:apk": "npm run sync:jdk && node scripts/run-with-jdk.js npx expo run:android --variant release",
    "build:apk:gradle": "npm run sync:jdk && node scripts/run-with-jdk.js ./gradlew assembleRelease",
    "build:apk:eas": "eas build --platform android --profile production"
  },
  "dependencies": {
