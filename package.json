    "expo": "55.0.10-canary-20260328-2049187",
    "expo-camera": "^55.0.12-canary-20260328-2049187",
    "expo-constants": "55.0.10-canary-20260328-2049187",
    "expo-file-system": "^55.0.13-canary-20260328-2049187",
    "expo-image": "^55.0.7-canary-20260328-2049187",
    "expo-image-manipulator": "55.0.12-canary-20260328-2049187",
    "expo-image-picker": "^55.0.15-canary-20260328-2049187",
    "expo-print": "55.0.10-canary-20260328-2049187",
    "expo-sharing": "55.0.15-canary-20260328-2049187",
