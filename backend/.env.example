# ─────────────────────────────────────────────────────────────
# Backend (OTP + auto-update) server environment.
# Copy to `.env` for local development, or set these as environment
# variables on your host (Render dashboard / Docker / VPS).
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001
# Use "production" when deployed: it enables HTTPS enforcement and disables
# the development OTP echo (demoOtp).
NODE_ENV=development

# Supabase (required for signup). Use the SERVICE ROLE key — server-side only,
# never ship it in the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MSG91 OTP (optional - falls back to demo mode). Required for real SMS.
MSG91_AUTHKEY=your-msg91-authkey
MSG91_SENDER=MCAFONE

# CORS (comma-separated origins). Native apps send no Origin header, so this
# only matters for a web client. Keep it strict (avoid "*") in production.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── App Update Configuration ──────────────────────────────────
# The Android/update check reads these. Bump on every release; versionCode must
# strictly increase or clients will not see the update.
APP_LATEST_VERSION_NAME=1.0.6
APP_LATEST_VERSION_CODE=7
APP_DOWNLOAD_URL_ANDROID=https://github.com/rootvivek/myapp/releases/download/v1.0.6/app-release.apk
APP_DOWNLOAD_URL_IOS=https://apps.apple.com/app/idYOUR_APP_ID
# "\n" is converted to real newlines by the server.
APP_RELEASE_NOTES=Auto-update feature added\nFixed customer screen UI\nPerformance improvements
APP_MANDATORY_UPDATE=false
APP_MIN_VERSION_CODE=4
