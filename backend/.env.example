# Server
PORT=3001
NODE_ENV=development

# Supabase (required for signup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MSG91 OTP (optional - falls back to demo mode)
MSG91_AUTHKEY=your-msg91-authkey
MSG91_SENDER=MCAFONE

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# App Update Configuration
# Update these when releasing a new version
APP_LATEST_VERSION_NAME=1.0.5
APP_LATEST_VERSION_CODE=6
APP_DOWNLOAD_URL_ANDROID=https://github.com/rootvivek/myapp/releases/download/v1.0.5/app-release.apk
APP_DOWNLOAD_URL_IOS=https://apps.apple.com/app/idYOUR_APP_ID
APP_RELEASE_NOTES=Auto-update feature added\nFixed customer screen UI\nPerformance improvements
APP_MANDATORY_UPDATE=false
APP_MIN_VERSION_CODE=4