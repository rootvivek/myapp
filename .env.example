# ─────────────────────────────────────────────────────────────
# Client environment. Copy to `.env` and fill in real values.
# Loaded at bundle time by react-native-dotenv (see babel.config.js).
# After changing values, restart Metro with: npm start -- --reset-cache
# ─────────────────────────────────────────────────────────────

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# MSG91 OTP (optional – enables the native OTP widget)
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=

# Auto-update
# Base URL of the backend that serves POST /app/update/check.
# Physical device: use your LAN IP (e.g. http://192.168.1.50:3001), not localhost.
UPDATE_API_URL=http://localhost:3001
# How often to check, in milliseconds (14400000 = 4 hours)
UPDATE_CHECK_INTERVAL=14400000
ENABLE_CODE_PUSH=false
ENABLE_APK_UPDATE=true
AUTO_DOWNLOAD_APK=true
SHOW_RELEASE_NOTES=true

# Current app version (keep in sync with android/app/build.gradle)
APP_VERSION_NAME=1.0.5
APP_VERSION_CODE=6
