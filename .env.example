# ─────────────────────────────────────────────────────────────
# Client environment. Copy to `.env` and fill in real values.
# Loaded at bundle time by react-native-dotenv (see babel.config.js).
# After changing values, restart Metro with: npm start -- --reset-cache
# ─────────────────────────────────────────────────────────────
#
# PRODUCTION: this file is baked into the release APK. Before `npm run build:apk`
# set UPDATE_API_URL to your HTTPS backend and the real Supabase credentials.

# Supabase (use the project URL and the public ANON key — never the service role key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# MSG91 OTP (optional – enables the native OTP widget)
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=

# Auto-update
# Base URL of the deployed backend that serves POST /app/update/check.
# Development: http://localhost:3001 is auto-rewritten to a reachable host
#   (Metro's LAN IP, or 10.0.2.2 on an Android emulator).
# Production: MUST be the public HTTPS URL, e.g.
#   UPDATE_API_URL=https://myapp-otp-server.onrender.com
UPDATE_API_URL=http://localhost:3001
# How often to check, in milliseconds (14400000 = 4 hours)
UPDATE_CHECK_INTERVAL=14400000
ENABLE_CODE_PUSH=false
ENABLE_APK_UPDATE=true
AUTO_DOWNLOAD_APK=true
SHOW_RELEASE_NOTES=true

# Current app version (keep in sync with android/app/build.gradle)
APP_VERSION_NAME=1.0.6
APP_VERSION_CODE=7
